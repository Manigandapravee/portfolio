    </div>
  </div>
</section>

<footer>
  <p>✦ Crafted with passion by <strong>Manigandapravi G</strong> · 2026 ✦</p>
</footer>

<script>
// ── STARS ──
const starsCanvas = document.getElementById('stars-canvas');
const sCtx = starsCanvas.getContext('2d');
let stars = [];
function resizeStars() {
  starsCanvas.width = window.innerWidth;
  starsCanvas.height = window.innerHeight;
}
function initStars() {
  stars = [];
  for (let i = 0; i < 180; i++) {
    stars.push({
      x: Math.random() * starsCanvas.width,
      y: Math.random() * starsCanvas.height,
      r: Math.random() * 1.2 + 0.2,
      alpha: Math.random(),
      speed: Math.random() * 0.005 + 0.002,
      phase: Math.random() * Math.PI * 2
    });
  }
}
function drawStars(t) {
  sCtx.clearRect(0, 0, starsCanvas.width, starsCanvas.height);
  stars.forEach(s => {
    const a = 0.3 + 0.7 * Math.abs(Math.sin(t * s.speed + s.phase));
    sCtx.beginPath();
    sCtx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
    sCtx.fillStyle = `rgba(200,230,255,${a})`;
    sCtx.fill();
  });
}
resizeStars(); initStars();
window.addEventListener('resize', () => { resizeStars(); initStars(); });

// ── BIRD CURSOR ──
const birdCanvas = document.getElementById('bird-canvas');
const bCtx = birdCanvas.getContext('2d');
birdCanvas.width = window.innerWidth;
birdCanvas.height = window.innerHeight;
window.addEventListener('resize', () => {
  birdCanvas.width = window.innerWidth;
  birdCanvas.height = window.innerHeight;
});

let mouseX = window.innerWidth / 2;
let mouseY = window.innerHeight / 2;
let birdX = mouseX, birdY = mouseY;
let birdAngle = 0;
let wingPhase = 0;
let trail = [];

const dot = document.getElementById('cursor-dot');
const ring = document.getElementById('cursor-ring');

document.addEventListener('mousemove', e => {
  mouseX = e.clientX;
  mouseY = e.clientY;
  dot.style.left = mouseX + 'px';
  dot.style.top = mouseY + 'px';
  ring.style.left = mouseX + 'px';
  ring.style.top = mouseY + 'px';
});

function drawBird(x, y, angle, wingFlap, size, alpha) {
  bCtx.save();
  bCtx.translate(x, y);
  bCtx.rotate(angle);
  bCtx.globalAlpha = alpha;

  const wing = Math.sin(wingFlap) * 0.6; // wing angle
  const color = `rgba(79,195,247,${alpha})`;
  const glow = `rgba(79,195,247,${alpha * 0.3})`;

  // Glow
  bCtx.shadowColor = '#4fc3f7';
  bCtx.shadowBlur = 10 * alpha;

  // Body
  bCtx.beginPath();
  bCtx.ellipse(0, 0, size * 0.7, size * 0.25, 0, 0, Math.PI * 2);
  bCtx.fillStyle = color;
  bCtx.fill();

  // Left wing
  bCtx.save();
  bCtx.rotate(-wing);
  bCtx.beginPath();
  bCtx.moveTo(-size * 0.1, 0);
  bCtx.quadraticCurveTo(-size * 0.8, -size * 0.6 * Math.max(0.1, 1 - wing), -size * 1.2, size * 0.1);
  bCtx.quadraticCurveTo(-size * 0.5, 0.1, -size * 0.1, 0);
  bCtx.fillStyle = color;
  bCtx.fill();
  bCtx.restore();

  // Right wing
  bCtx.save();
  bCtx.rotate(wing);
  bCtx.scale(1, -1);
  bCtx.beginPath();
  bCtx.moveTo(-size * 0.1, 0);
  bCtx.quadraticCurveTo(-size * 0.8, -size * 0.6 * Math.max(0.1, 1 - wing), -size * 1.2, size * 0.1);
  bCtx.quadraticCurveTo(-size * 0.5, 0.1, -size * 0.1, 0);
  bCtx.fillStyle = color;
  bCtx.fill();
  bCtx.restore();

  // Tail
  bCtx.beginPath();
  bCtx.moveTo(-size * 0.6, 0);
  bCtx.lineTo(-size * 1.1, -size * 0.2);
  bCtx.lineTo(-size * 1.1, size * 0.2);
  bCtx.closePath();
  bCtx.fillStyle = color;
  bCtx.fill();

  // Head
  bCtx.beginPath();
  bCtx.arc(size * 0.55, 0, size * 0.22, 0, Math.PI * 2);
  bCtx.fillStyle = color;
  bCtx.fill();

  // Eye
  bCtx.beginPath();
  bCtx.arc(size * 0.63, -size * 0.05, size * 0.055, 0, Math.PI * 2);
  bCtx.fillStyle = '#060c1a';
  bCtx.fill();

  // Beak
  bCtx.beginPath();
  bCtx.moveTo(size * 0.75, -size * 0.03);
  bCtx.lineTo(size * 0.98, 0);
  bCtx.lineTo(size * 0.75, size * 0.06);
  bCtx.closePath();
  bCtx.fillStyle = '#ffd166';
  bCtx.fill();

  bCtx.shadowBlur = 0;
  bCtx.restore();
}

let t = 0;
function animate() {
  t++;
  wingPhase += 0.18;

  // Smooth follow
  const speed = 0.12;
  const dx = mouseX - birdX;
  const dy = mouseY - birdY;
  birdX += dx * speed;
  birdY += dy * speed;

  // Angle toward target
  const targetAngle = Math.atan2(dy, dx);
  let da = targetAngle - birdAngle;
  while (da > Math.PI) da -= Math.PI * 2;
  while (da < -Math.PI) da += Math.PI * 2;
  birdAngle += da * 0.1;

  // Trail
  const dist = Math.sqrt(dx * dx + dy * dy);
  if (dist > 5) {
    trail.push({ x: birdX, y: birdY, t: t });
  }
  trail = trail.filter(p => t - p.t < 18);

  bCtx.clearRect(0, 0, birdCanvas.width, birdCanvas.height);

  drawStars(t);

  // Draw trail birds (smaller, fading)
  for (let i = 0; i < trail.length; i += 3) {
    const p = trail[i];
    const age = t - p.t;
    const alpha = (1 - age / 18) * 0.25;
    const s = 8 * (1 - age / 18);
    drawBird(p.x, p.y, birdAngle, wingPhase - i * 0.1, s, alpha);
  }

  // Main bird
  drawBird(birdX, birdY, birdAngle, wingPhase, 14, 1);

  requestAnimationFrame(animate);
}
animate();

// ── SCROLL REVEAL ──
const reveals = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver(entries => {
  entries.forEach((e, i) => {
    if (e.isIntersecting) {
      setTimeout(() => e.target.classList.add('visible'), i * 80);
      observer.unobserve(e.target);
    }
  });
}, { threshold: 0.12 });
reveals.forEach(el => observer.observe(el));
</script>
</body>
</html>
